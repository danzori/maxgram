# REQUIRED

# web.max.ru -> F12 -> Application -> Local Storage:
# __oneme_auth -> the "token" field of that object, not the whole object
# __oneme_device_id -> the value as is
MAX_TOKEN=
MAX_DEVICE_ID

# @BotFather
# Also need: @BotFather -> Open Mini App -> Select bot -> Bot settings -> Enable "Threaded Mode"
TG_BOT_TOKEN=

# @userinfobot
TG_CHAT_ID=


# OPTIONAL

# MAX_WS_URL=wss://ws-api.oneme.ru/websocket
# MAX_RECONNECT_INTERVAL=5s
# MAX_HEARTBEAT_INTERVAL=30s
# MAX_REQUEST_TIMEOUT=15s

# MAX_PROTOCOL_VERSION=10
